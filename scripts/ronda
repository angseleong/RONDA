sc_uc02_offline() {
  local p
  p="$(protected)"
  fresh_pair
  airplane "$p" enable
  cmd_attack sms
  cmd_victim sms
  expect_overlay "$p" on "Overlay tetap jalan tanpa internet"
  "$ADB" -s "$p" shell input keyevent KEYCODE_HOME
  pause "Rondor belum dapat apa-apa. Lanjut untuk menyalakan internet Rondee"
  airplane "$p" disable
  expect "$(guardian)" "Undangan Pernikahan" "Alert tertunda terkirim setelah online"
}

sc_uc02_update() {
  local p apk
  p="$(protected)"
  fresh_pair
  cmd_attack sms
  pause "Satu alert 'Undangan Pernikahan' di Rondor. Lanjut untuk memperbarui aplikasinya"
  apk="$ROOT/RondaTestSample/app/build/outputs/apk/sms/debug/app-sms-debug.apk"
  "$ADB" -s "$p" install -r -t "$apk" >/dev/null
  say "Diperbarui (install -r). Blokir tetap, dan tidak ada alert kedua"
  cmd_victim sms
  pause "Cek Rondor: tetap SATU alert, tidak muncul lagi di 'Perlu diperiksa'"
}

sc_uc02_reinstall_safe() {
  local p
  p="$(protected)"
  fresh_pair
  cmd_attack sms
  pause "Di Rondor: buka alert → Tandai aman → Ya, tandai aman. Tunggu 10 detik"
  say "Dihapus lalu dipasang ulang"
  "$ADB" -s "$p" uninstall "$SAMPLE_PKG" >/dev/null
  sleep 3
  cmd_attack sms
  pause "Cek Rondor: kartu baru di 'Perlu diperiksa', DAN Riwayat masih mencatat 'aman' + 'dihapus' dari pemasangan pertama"
}

sc_uc03_overlay() {
