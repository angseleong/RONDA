  say "Umpan dipasang SEBELUM pairing — hanya initial scan yang bisa menemukannya"
  cmd_attack sms
  cmd_open; sleep 4; cmd_role; sleep 3; cmd_pair; cmd_perms
  tap_text "$p" "Periksa sekarang"
  expect "$p" "Scan selesai: 1 aplikasi.*" "Initial scan menemukan umpan"
  expect "$g" "Undangan Pernikahan" "Alert sampai di Rondor"
}

