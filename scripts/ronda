# id | function | one-line description, listed in this order.
SCENARIOS="
uc01-pair|sc_uc01_pair|Pairing pertama lewat kode teks
uc01-qr|sc_uc01_qr|Pairing lewat QR / deep link ronda://pair
uc01-multi|sc_uc01_multi|Rondee kedua di Rondor yang sama (HP ketiga)
uc01-disconnect-rondee|sc_uc01_disconnect_rondee|Rondee memutus → keduanya mulai dari awal
uc01-disconnect-rondor|sc_uc01_disconnect_rondor|Rondor memutus → keduanya mulai dari awal
uc01-invalid|sc_uc01_invalid|Kode salah ditolak
uc01-used|sc_uc01_used|Kode yang sudah dipakai ditolak
uc01-expired|sc_uc01_expired|Kode kedaluwarsa (menunggu 10 menit)
uc01-offline|sc_uc01_offline|Pairing tanpa internet di kedua sisi
uc02-initial|sc_uc02_initial|Initial scan menemukan APK yang sudah terpasang
uc02-realtime|sc_uc02_realtime|Deteksi real-time saat APK dipasang
uc02-scan-again|sc_uc02_scan_again|Scan ulang manual
uc02-safe-install|sc_uc02_safe_install|Instalasi aman tidak memicu alert
uc02-offline|sc_uc02_offline|Rondee offline: blokir jalan, alert menyusul
uc02-update|sc_uc02_update|Update APK yang ditandai: tidak ada alert ganda
uc02-reinstall-safe|sc_uc02_reinstall_safe|APK aman dihapus lalu dipasang ulang
uc03-overlay|sc_uc03_overlay|Overlay menutup APK berbahaya
uc03-back|sc_uc03_back|Back dan ketukan tidak menembus overlay
uc03-permission|sc_uc03_permission|Izin overlay dicabut lalu dipulihkan
uc03-reboot|sc_uc03_reboot|Restart HP: blokir pulih tanpa membuka RONDA
uc04-uninstall|sc_uc04_uninstall|Rondor minta hapus, Rondee konfirmasi
uc04-safe|sc_uc04_safe|Rondor tandai aman, overlay dicabut
uc04-undo|sc_uc04_undo|Batalkan tandai aman, blokir kembali
uc04-defer|sc_uc04_defer|Rondee menunda, Rondor kirim ulang
uc05-onboarding|sc_uc05_onboarding|Splash dan onboarding dari awal
uc05-wizard|sc_uc05_wizard|Wizard izin di HP Rondee
uc06-offline|sc_uc06_offline|Rondor offline: penanda Terputus
"

cmd_scenario() {
  local id="${1:-}" line sid fn desc
  if [ -z "$id" ]; then
    echo "scripts/ronda scenario <id>   (docs/USE_CASES.md)"
    echo
    echo "$SCENARIOS" | while IFS='|' read -r sid fn desc; do
      if [ -n "$sid" ]; then printf '  %-24s %s\n' "$sid" "$desc"; fi
    done
    return
  fi
  line="$(echo "$SCENARIOS" | grep "^$id|" || true)"
  [ -n "$line" ] || die "Skenario tidak dikenal: $id (lihat: scripts/ronda scenario)"
  fn="$(echo "$line" | cut -d'|' -f2)"
  desc="$(echo "$line" | cut -d'|' -f3)"
  say "Skenario $id — $desc"
  "$fn"
  say "Skenario $id selesai"
}

cmd_help() {
  cat <<'EOF'
scripts/ronda <perintah>

  demo      Simulasi penuh dari nol: nyalakan → pasang → reset → pilih peran →
            pairing → sideload APK READ_SMS. Ini yang dipakai kalau mau lihat
            seluruh alur dalam satu perintah.

  up        Nyalakan kedua emulator (skip yang sudah jalan)
  install   Build + pasang RONDA di semua HP yang jalan
  reset     pm clear semua HP → balik ke layar pilih bahasa (data RONDA dihapus)
  perms     Beri izin notifikasi, overlay, usage stats lewat adb
  open      Buka RONDA di semua HP
  role      Bahasa → intro → peran otomatis: HP-1 = Rondee, HP-2 = Rondor
  pair      Isi nama di Rondor, baca kodenya, ketikkan di HP Rondee
  attack [flavor] [sumber]
            Pasang satu APK umpan di HP orang tua.

            flavor = jenis izin bahaya yang diminta APK:
              sms (default) | accessibility | notification | overlay
              | deviceadmin | dropper
            sumber = seolah dipasang dari mana:
              not_playstore (default) → sideload, kayak download APK dari luar
              playstore              → seolah dari Play Store

            Contoh:
              attack                    → sideload SMS → RONDA alert
              attack accessibility      → sideload accessibility → RONDA alert
              attack sms playstore      → seolah dari Play Store → RONDA diam
                                          (bukti: butuh 2 sinyal buat alert)

            Tambah --on rondee2 untuk memasang umpan di HP ketiga:
              attack sms --on rondee2   → sideload SMS di Rondee kedua

            Skor tiap flavor ada di RondaTestSample/README.md.
  victim [flavor] [--on rondee2]
            Buka APK umpan di HP orang tua → overlay RONDA menutupinya.
            Tanpa argumen: flavor dari `attack` terakhir.
  add-rondee [--auto]
            HP ketiga = Rondee kedua di Rondor yang sama (demo multi-HP).
            Bikin AVD RONDA_Rondee2 kalau belum ada, nyalakan, pasang, kasih
            izin, lalu berhenti — buka RONDA sendiri, mulai dari pilih bahasa.
            --auto: jalankan terus sampai pairing lewat "Tambah HP lain" di
            Rondor (Rondor harus sudah paired, jalankan setelah `demo`).
  fixture   Rondor langsung ke mode demo DEMO01: lima aplikasi contoh,
            tanpa jaringan dan tanpa HP kedua (cadangan kalau Wi-Fi venue jelek)
  scenario [id]
            Demo satu skenario dari docs/USE_CASES.md dari awal sampai
            dicek hasilnya. Tanpa id: daftar semua skenario.
            Contoh: scenario uc02-realtime, scenario uc01-disconnect-rondor
  status    Peran + pairing tiap HP
  logs      Logcat gabungan semua HP, hanya tag RONDA (Ctrl-C untuk berhenti)
  shot      Screenshot semua HP ke build/demo-shots/

install/reset/perms/open ikut menyentuh HP ketiga kalau sedang jalan.
AVD bisa diganti lewat env: RONDA_PROTECTED_AVD, RONDA_GUARDIAN_AVD,
RONDA_PROTECTED2_AVD
EOF
}

cmd="${1:-help}"
if [ $# -gt 0 ]; then shift; fi

case "$cmd" in
  demo|up|install|reset|perms|open|role|pair|attack|victim|fixture|status|logs|shot|help)
    "cmd_$cmd" "$@" ;;
  add-rondee) cmd_add_rondee "$@" ;;
  scenario) cmd_scenario "$@" ;;
  *) die "Perintah tidak dikenal: $cmd (lihat: scripts/ronda help)" ;;
esac
