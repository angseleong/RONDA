  cmd_victim sms
}

sc_uc03_back() {
  local p
  p="$(protected)"
  fresh_pair
  cmd_attack sms
  cmd_victim sms
  "$ADB" -s "$p" shell input keyevent KEYCODE_BACK
  expect_overlay "$p" on "Back tidak menembus overlay"
  "$ADB" -s "$p" shell input tap 540 1200
  expect_overlay "$p" on "Ketukan tidak menembus overlay"
  "$ADB" -s "$p" shell input keyevent KEYCODE_HOME
}

sc_uc03_permission() {
  local p
  p="$(protected)"
  fresh_pair
  cmd_attack sms
  "$ADB" -s "$p" shell appops set "$PKG" SYSTEM_ALERT_WINDOW deny
  say "Izin overlay dicabut"
  "$ADB" -s "$p" shell am start -n "$SAMPLE_PKG/$SAMPLE_PKG.MainActivity" >/dev/null
  expect_overlay "$p" off "Tanpa izin: overlay tidak jalan (alert tetap terkirim)"
  rondee_home "$p"
  expect "$p" "Lanjutkan pengaturan" "Beranda Rondee minta lanjutkan pengaturan"
  grant_protected "$p"
  rondee_home "$p"
  cmd_victim sms
}

sc_uc03_reboot() {
  local p
  p="$(protected)"
  fresh_pair
  cmd_attack sms
  say "Rondee di-restart. RONDA TIDAK dibuka setelahnya"
  "$ADB" -s "$p" reboot
  sleep 10
  boot_avd "$PROTECTED_AVD"
  sleep 15
  cmd_victim sms
}

