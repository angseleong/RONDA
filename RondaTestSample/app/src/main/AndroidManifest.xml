<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
        Manifest DASAR yang dipakai bersama semua flavor.

        Sengaja TIDAK ada satu pun <uses-permission> di sini. Tiap flavor
        (src/<flavor>/AndroidManifest.xml) menambahkan sinyal deteksinya sendiri,
        supaya tiap APK umpan menguji satu kelompok parameter RONDA secara
        terisolasi. Lihat README.md untuk peta lengkapnya.

        MainActivity di sini TIDAK punya kategori LAUNCHER. Kategori itu
        ditambahkan oleh tiap flavor yang perlu ikon — kecuali flavor
        `deviceadmin`, yang sengaja tanpa ikon untuk menguji sinyal NO_LAUNCHER.
    -->

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name" />

    </application>

</manifest>
