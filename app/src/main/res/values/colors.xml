<?xml version="1.0" encoding="utf-8"?>
<!--
    Only the View-based surfaces live here: the warning overlay, which is
    inflated from XML by OverlayService, and the launch window background.
    Everything Compose draws comes from `ui/theme/Color.kt` — do not duplicate a
    value across the two, or the overlay will drift away from the app it belongs
    to.

    The Android template's purple/teal defaults were removed; nothing referenced
    them.
-->
<resources>

    <!-- Matches `bandUrgent` in Color.kt. Deliberately NOT Android system styling:
         imitating a system dialog is the technique overlay trojans use. -->
    <color name="overlay_background">#FF8C1010</color>

    <!-- The reason panel, one step lighter so it reads as inset rather than as a
         second alert. -->
    <color name="overlay_panel">#33FFFFFF</color>

    <color name="overlay_text_primary">#FFFFFFFF</color>
    <color name="overlay_text_secondary">#FFFFD9D9</color>

    <!-- Launch window. Matches `paper` so there is no dark flash before Compose
         draws its first frame. -->
    <color name="window_background">#FFF5F8F9</color>

</resources>
