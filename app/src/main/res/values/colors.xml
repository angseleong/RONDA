<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Window background before Compose draws, so a cold start never flashes
         the wrong colour. Overridden in values-night. -->
    <color name="window_bg">#FFFFFFFF</color>

    <!-- Warning overlay: drenched in danger red, deliberately NOT system styling.
         Theme-independent — an alarm looks the same at noon and at midnight. -->
    <color name="overlay_bg">#FFB91C1C</color>
    <color name="overlay_text_primary">#FFFFFFFF</color>
    <color name="overlay_text_secondary">#FFFECACA</color>
    <color name="overlay_card">#FFFFFFFF</color>
    <color name="overlay_card_border">#FFFCA5A5</color>
    <color name="overlay_danger">#FFDC2626</color>
    <color name="overlay_danger_tint">#FFFFF1F1</color>
    <color name="overlay_ink">#FF0F172A</color>
    <color name="overlay_ink_secondary">#FF64748B</color>
</resources>
