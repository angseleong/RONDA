<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!--
        AppCompat DayNight so the theme toggle (AppCompatDelegate.setDefaultNightMode)
        and per-app language both apply to the Activity. The window paints the page
        colour before the first frame, so launch never flashes the wrong theme.
    -->
    <style name="Theme.RONDA" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/window_bg</item>
    </style>

    <!--
        Splash, first half: only the page colour, drawn by the system on
        Android 12+ and by core-splashscreen on API 30–31. The logo is left
        out on purpose — SplashIntro animates it in Compose straight after,
        and a static one here would flash before the pop. window_bg has a
        night value, so a dark phone does not open on a white flash.
    -->
    <style name="Theme.RONDA.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/window_bg</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_blank</item>
        <item name="postSplashScreenTheme">@style/Theme.RONDA</item>
    </style>
</resources>
