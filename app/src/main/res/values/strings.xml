<?xml version="1.0" encoding="utf-8"?>
<!--
    English is the default resource set on purpose: a phone whose system
    language is English but whose app language is Indonesian resolves
    [id, en]; without an explicit values-in folder, values-en would beat the
    default. Indonesian, the primary language, lives in values-in.
-->
<resources>
    <string name="app_name" translatable="false">RONDA</string>
    <string name="lang_indonesian" translatable="false">Bahasa Indonesia</string>
    <string name="lang_indonesian_body" translatable="false">Semua tulisan dalam Bahasa Indonesia</string>
    <string name="lang_english" translatable="false">English</string>
    <string name="lang_english_body" translatable="false">All text in English</string>
    <string name="overlay_brand" translatable="false">RONDA</string>
    <string name="action_cancel">Cancel</string>
    <string name="action_close">Close</string>

    <string name="lang_title">Choose a language</string>
    <string name="lang_body">Used across the whole app. You can change it later in Settings.</string>
    <string name="lang_continue">Continue</string>

    <string name="intro_title">RONDA guards phones against social engineering scams</string>
    <string name="intro_body">Scammers send app files over WhatsApp, like an invitation, a delivery receipt, or a bill. Once installed, that app can read bank OTP codes.</string>
    <string name="intro_point_1_title">Caught at install time</string>
    <string name="intro_point_1_body">RONDA checks every new app that arrives from outside the Play Store.</string>
    <string name="intro_point_2_title">The Rondor is told</string>
    <string name="intro_point_2_body">The alert goes to the Rondor (guardian) phone, not to the person being scammed.</string>
    <string name="intro_point_3_title">The app is covered</string>
    <string name="intro_point_3_body">A dangerous app is covered by a RONDA warning until the guardian decides.</string>
    <string name="intro_privacy">RONDA never reads your messages, never asks for SMS permission, and never uses the Accessibility service.</string>
    <string name="intro_start">Get started</string>

    <!-- Role selection: Rondee vs Rondor -->
    <string name="role_title">Role of this device</string>
    <string name="role_subtitle">Choose how RONDA will be used on this phone.</string>
    <string name="role_protected_title">Rondee (Protected Device)</string>
    <string name="role_protected_body">RONDA watches this phone. If a dangerous app is installed, RONDA blocks it and notifies your Rondor.</string>
    <string name="role_guardian_title">Rondor (Guardian Device)</string>
    <string name="role_guardian_body">RONDA sends alerts to this phone when suspicious activity happens on Rondee devices you safeguard.</string>
    <string name="role_note">Once chosen, the role cannot be changed without reinstalling the app.</string>
    <string name="role_continue">Continue</string>

    <string name="pair_nickname_title">Who will you be guarding?</string>
    <string name="pair_guardian_name_title">What is your name?</string>
    <string name="pair_guardian_name_body">Shown on the Rondee phone, as \"Guarded by …\".</string>
    <string name="pair_guardian_name_placeholder">For example: Rina</string>
    <string name="pair_nickname_body">This name appears on every screen, for example \"Mum\'s phone\".</string>
    <string name="pair_nickname_field">Another name</string>
    <string name="pair_nickname_placeholder">For example: Aunt Sari</string>
    <string name="pair_nickname_continue">Continue</string>
    <string-array name="nickname_options">
        <item>Mum</item>
        <item>Dad</item>
        <item>Grandma</item>
        <item>Grandpa</item>
        <item>Mom</item>
        <item>Papa</item>
    </string-array>
    <string name="pair_guardian_for">For %1$s\'s phone</string>
    <string name="pair_guardian_change_name">Change name</string>
    <string name="pair_guardian_title">Connect to Rondee phone</string>
    <string name="pair_guardian_step">Open RONDA on %1$s\'s phone, choose \"Rondee (Protected Device)\", then enter the code below.</string>
    <string name="pair_guardian_code_label">Pairing code</string>
    <string name="pair_guardian_or_scan_label">Or scan</string>
    <string name="pair_guardian_or_scan">If both phones are in the same room, scan this QR code with the other phone\'s camera.</string>
    <string name="pair_guardian_waiting">Waiting for the other phone to enter the code…</string>
    <string name="pair_guardian_expiry">The code is valid for 10 minutes.</string>
    <string name="pair_qr_desc">QR code containing the pairing code</string>
    <string name="pair_creating">Creating a code…</string>
    <string name="pair_retry">Try again</string>

    <string name="pair_protected_title">Enter the code from the Rondor phone</string>
    <string name="pair_protected_step">Ask the owner of the Rondor phone to open RONDA and read out the 6-character code shown on their phone.</string>
    <string name="pair_protected_field">Pairing code</string>
    <string name="pair_protected_submit">Connect</string>
    <string name="pair_error_invalid">The code is 6 letters or digits.</string>
    <string name="pair_error_notfound">Code not found. Check what you typed.</string>
    <string name="pair_error_used">This code has already been used. Ask for a new one.</string>
    <string name="pair_error_expired">This code has expired. Ask for a new one.</string>
    <string name="pair_error_offline">Could not reach the server. Check the internet connection, then try again.</string>
    <string name="pair_connecting">Connecting…</string>

    <string name="setup_title">RONDA setup</string>
    <string name="setup_step_of">Step %1$d of %2$d</string>
    <string name="setup_wizard_hint">The phone will open a Settings page. Turn it on, then come back to RONDA.</string>
    <string name="setup_all_done_label">All steps done</string>
    <string name="setup_all_done_title">Everything is on</string>
    <string name="setup_all_done_body">RONDA is now protecting this phone.</string>
    <string name="setup_finish">Done</string>

    <string name="permission_enable">Turn on</string>

    <string name="permission_notifications_title">Notifications</string>
    <string name="permission_notifications_why">So RONDA can tell you when a dangerous app is installed.</string>
    <string name="permission_overlay_title">Display over other apps</string>
    <string name="permission_overlay_why">So RONDA can cover a dangerous app with a warning. RONDA cannot read what is on your screen.</string>
    <string name="permission_usage_title">Usage access</string>
    <string name="permission_usage_why">So RONDA knows which app is open. It sees only the app\'s name, never its contents.</string>
    <string name="permission_battery_title">No battery restriction</string>
    <string name="permission_battery_why">So the phone does not shut RONDA down in the background. Without this, RONDA can stop watching without telling anyone.</string>

    <string name="setup_privacy_note">RONDA never asks for SMS permission, never reads your messages, and never uses the Accessibility service.</string>

