<?xml version="1.0" encoding="utf-8"?>
<!--
    Launcher icon ground.

    Plain white, not the app's `paper`: the mark is teal and amber on a
    transparent field, and every launcher mask (circle, squircle, rounded
    square) crops this differently. A flat ground is the only one that survives
    all of them without an edge artefact, and white is what the mark was drawn
    against.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M0,0h108v108h-108z" />
</vector>
