<?xml version="1.0" encoding="utf-8"?>
<!--
    RONDA warning overlay.

    Two hard rules from the PRD apply to this layout:
    1. It is clearly branded as RONDA and must never imitate an Android system
       dialog — that is the technique used by overlay-based banking trojans.
    2. There is no "continue anyway" button. The only exits are the Home button
       or the guardian marking the app safe.

    Drenched in the danger red from docs/DESIGN.md with the same card, border
    and solid drop as every Compose screen, set in Nunito, so it reads as RONDA
    and not as the phone. The variable font takes its weight from
    fontVariationSettings rather than textStyle, which would fake it.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/overlay_bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="56dp"
        android:paddingBottom="48dp">

        <!-- Wordmark: the user must know this is RONDA, not the system -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:adjustViewBounds="true"
                android:padding="8dp"
                android:background="@drawable/bg_overlay_mark"
                android:src="@drawable/ronda_mark"
                android:contentDescription="@null"
                android:importantForAccessibility="no" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:text="@string/overlay_brand"
                android:textColor="@color/overlay_text_primary"
                android:fontFamily="@font/nunito"
                android:fontVariationSettings="'wght' 900"
                android:textSize="28sp" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/overlay_brand_tagline"
            android:textColor="@color/overlay_text_secondary"
            android:fontFamily="@font/nunito"
            android:fontVariationSettings="'wght' 800"
            android:textSize="20sp" />

        <!-- The card: white on red, thick border, solid drop — the system's own card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:background="@drawable/bg_overlay_card"
            android:padding="24dp">

            <ImageView
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:padding="18dp"
                android:src="@drawable/ic_triangle_warning"
                android:tint="@color/overlay_danger"
                tools:ignore="UseAppTint"
                android:background="@drawable/bg_overlay_icon"
                android:contentDescription="@null"
                android:importantForAccessibility="no" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/overlay_title"
                android:textColor="@color/overlay_danger"
                android:fontFamily="@font/nunito"
                android:fontVariationSettings="'wght' 900"
                android:textSize="28sp"
                android:lineSpacingMultiplier="1.1"
                android:breakStrategy="balanced"
                android:gravity="center" />

            <!-- Filled in by OverlayService with the flagged app's label -->
            <TextView
                android:id="@+id/overlay_app_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:textColor="@color/overlay_ink"
                android:fontFamily="@font/nunito"
                android:fontVariationSettings="'wght' 900"
                android:textSize="24sp"
                android:gravity="center" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/overlay_body"
                android:textColor="@color/overlay_ink"
                android:fontFamily="@font/nunito"
                android:fontVariationSettings="'wght' 700"
                android:textSize="20sp"
                android:lineSpacingMultiplier="1.3"
                android:gravity="center" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1.5dp"
                android:layout_marginTop="20dp"
                android:background="@color/overlay_card_border" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/overlay_reason_label"
                android:textColor="@color/overlay_ink_secondary"
                android:fontFamily="@font/nunito"
                android:fontVariationSettings="'wght' 800"
                android:textSize="20sp" />

            <!-- Replaced by OverlayService with this app's own reasons; this is the fallback -->
            <TextView
                android:id="@+id/overlay_reason"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/overlay_reason"
                android:textColor="@color/overlay_ink"
                android:fontFamily="@font/nunito"
                android:fontVariationSettings="'wght' 700"
                android:textSize="20sp"
                android:lineSpacingMultiplier="1.3" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="@string/overlay_guardian_notified"
            android:textColor="@color/overlay_text_primary"
            android:fontFamily="@font/nunito"
            android:fontVariationSettings="'wght' 800"
            android:textSize="20sp"
            android:lineSpacingMultiplier="1.3"
            android:gravity="center" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/overlay_exit_hint"
            android:textColor="@color/overlay_text_secondary"
            android:fontFamily="@font/nunito"
            android:fontVariationSettings="'wght' 700"
            android:textSize="20sp"
            android:gravity="center" />
    </LinearLayout>
</ScrollView>
