<?xml version="1.0" encoding="utf-8"?>
<!--
    RONDA warning overlay.

    Two hard rules from the PRD apply to this layout:
    1. It is clearly branded as RONDA and must never imitate an Android system
       dialog — that is the technique used by overlay-based banking trojans.
    2. There is no "continue anyway" button. The only exits are the Home button
       or the guardian marking the app safe.

    Everything else is read by someone in their seventies who has just been told
    by a stranger on the phone to open this app, so the hierarchy is: what is
    happening, which app, why, and who already knows. In that order, nothing
    smaller than 18sp.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/overlay_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="52dp"
        android:paddingBottom="52dp">

        <!-- Branding: the user must know this is RONDA, not the system -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:background="@drawable/overlay_brand_bg"
            android:paddingStart="22dp"
            android:paddingEnd="22dp"
            android:paddingTop="12dp"
            android:paddingBottom="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/overlay_brand"
                android:textColor="@color/overlay_text_primary"
                android:textSize="26sp"
                android:textStyle="bold"
                android:letterSpacing="0.18" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/overlay_brand_tagline"
                android:textColor="@color/overlay_text_secondary"
                android:textSize="15sp" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="⚠"
            android:textColor="@color/overlay_text_primary"
            android:textSize="64sp"
            android:contentDescription="@null" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/overlay_title"
            android:textColor="@color/overlay_text_primary"
            android:textSize="32sp"
            android:textStyle="bold"
            android:lineSpacingMultiplier="1.15"
            android:gravity="center" />

        <!-- Filled in by OverlayService with the flagged app's label -->
        <TextView
            android:id="@+id/overlay_app_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:background="@drawable/overlay_panel_bg"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="14dp"
            android:paddingBottom="14dp"
            android:textColor="@color/overlay_text_primary"
            android:textSize="26sp"
            android:textStyle="bold"
            android:gravity="center" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="@string/overlay_body"
            android:textColor="@color/overlay_text_primary"
            android:textSize="21sp"
            android:lineSpacingMultiplier="1.3"
            android:gravity="center" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:orientation="vertical"
            android:background="@drawable/overlay_panel_bg"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/overlay_reason_label"
                android:textColor="@color/overlay_text_secondary"
                android:textSize="16sp"
                android:textStyle="bold"
                android:letterSpacing="0.08" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/overlay_reason"
                android:textColor="@color/overlay_text_primary"
                android:textSize="20sp"
                android:lineSpacingMultiplier="1.3" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="@string/overlay_guardian_notified"
            android:textColor="@color/overlay_text_primary"
            android:textSize="21sp"
            android:textStyle="bold"
            android:lineSpacingMultiplier="1.25"
            android:gravity="center" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="@string/overlay_exit_hint"
            android:textColor="@color/overlay_text_secondary"
            android:textSize="18sp"
            android:lineSpacingMultiplier="1.2"
            android:gravity="center" />
    </LinearLayout>
</ScrollView>
