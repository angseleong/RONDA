<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />

    <!--
        Lets RONDA open the system uninstall dialog when the guardian asks for an
        app to be removed. It only requests — the person holding the phone still
        confirms, and Android grants no way to skip that. Without this declared,
        ACTION_DELETE is refused silently: no dialog, no crash, no log unless you
        are looking at UninstallerActivity.
    -->
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />

    <!--
        Same failure shape as REQUEST_DELETE_PACKAGES above: without this declared,
        ACTION_REQUEST_IGNORE_BATTERY_OPTIMIZATIONS opens Settings' activity, which
        checks this permission in onCreate() and finish()es silently if missing —
        no dialog, no crash, no log.
    -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS"
        tools:ignore="BatteryLife" />

    <!-- Pairing + alert sync via Firebase Realtime Database. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
        Soft-block (FR-8). Both are granted manually in system Settings.
        SYSTEM_ALERT_WINDOW only draws on top; PACKAGE_USAGE_STATS only reveals
        the foreground package name. Neither can read screen content or input —
        that is why RONDA does not need (and must never use) an AccessibilityService.
    -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />


    <application
        android:name=".RondaApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.RONDA">

        <!--
            Persists the per-app language on API 30–32, where the framework has
            no LocaleManager yet. Disabled: it is metadata, never started.
        -->
        <service
            android:name="androidx.appcompat.app.AppLocalesMetadataHolderService"
            android:enabled="false"
            android:exported="false">
            <meta-data
                android:name="autoStoreLocales"
                android:value="true" />
        </service>

        <service
            android:name=".detection.DetectionService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Malware detection and monitoring" />
        </service>

        <service
            android:name=".overlay.OverlayService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Blocking a detected malicious app" />
        </service>

        <!--
            Guardian side only. Keeps the RTDB connection alive so an alert
            reaches the guardian while RONDA is in the background — the job FCM
            would do, minus the server. Never started on a protected device.
        -->
        <service
            android:name=".alert.GuardianAlertService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Listening for alerts from a paired device" />
        </service>

        <!--
            singleTask: the whole app is this one Activity, and it is entered from
            three directions — launcher, alert notification, and the pairing deep
            link below. Without it a scanned QR starts a *second* MainActivity on
            top of the running one, each with its own copy of the screen state.
            With it, every entry reaches the single instance through onNewIntent().
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.RONDA.Starting"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!--
                Pairing deep link: ronda://pair/XXXXXX — exactly what the
                guardian's QR already encodes (see QrCodeUtils.URI_PREFIX), so
                any camera or QR app can hand the code straight to RONDA and the
                protected person never types it.

                BROWSABLE is what lets an external scanner open it. The link only
                ever pre-fills the field; claiming the code still needs a tap on
                this device, which is what keeps pairing consensual and
                physically present (PRD FR-2).
            -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data android:scheme="ronda" android:host="pair" />
            </intent-filter>
        </activity>
    </application>

</manifest>